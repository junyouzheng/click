<Window x:Class="ClickFx.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="click"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display">
  <Window.Background>
    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#12151E" Offset="0"/>
      <GradientStop Color="#10141C" Offset="0.62"/>
      <GradientStop Color="#16130F" Offset="1"/>
    </LinearGradientBrush>
  </Window.Background>
  <Border CornerRadius="0" BorderThickness="1">
    <Border.BorderBrush>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6A5434" Offset="0"/>
        <GradientStop Color="#2E3A52" Offset="0.55"/>
        <GradientStop Color="#2C6A58" Offset="1"/>
      </LinearGradientBrush>
    </Border.BorderBrush>
    <DockPanel>
      <Border DockPanel.Dock="Top" Height="2">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F3C56A" Offset="0"/>
            <GradientStop Color="#7EB6FF" Offset="0.52"/>
            <GradientStop Color="#7EE0C3" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Grid DockPanel.Dock="Top" Height="58">
        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="click" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="星火与手机键盘" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0">
          <Ellipse Width="8" Height="8" Fill="#F3C56A" Margin="0,0,6,0"/>
          <Ellipse Width="8" Height="8" Fill="#7EB6FF" Margin="0,0,6,0"/>
          <Ellipse Width="8" Height="8" Fill="#7EE0C3"/>
        </StackPanel>
      </Grid>

      <StackPanel Margin="16,4,16,16">
        <TextBlock Text="鼠标" Style="{StaticResource SectionLabel}"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Margin="0,0,0,12">
              <StackPanel Margin="0,0,58,0">
                <TextBlock Text="光效" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="点击放出星火，滑动留下浅蓝光尾" Style="{StaticResource RowNote}"/>
              </StackPanel>
              <CheckBox x:Name="EffectsBox" Style="{StaticResource ToggleSwitch}"
                        HorizontalAlignment="Right" Background="#F0C56A" Click="EffectsClick"/>
            </Grid>
            <Rectangle Height="1" Fill="#2A3142" Margin="0,0,0,12"/>
            <Grid>
              <StackPanel Margin="0,0,58,0">
                <TextBlock Text="点击声" Style="{StaticResource RowTitle}"/>
                <TextBlock Text="左、右、中键是手机键盘轻点" Style="{StaticResource RowNote}"/>
              </StackPanel>
              <CheckBox x:Name="SoundBox" Style="{StaticResource ToggleSwitch}"
                        HorizontalAlignment="Right" Background="#8EBEFF" Click="SoundClick"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Text="键盘" Style="{StaticResource SectionLabel}" Margin="4,8,0,8"/>
        <Border Style="{StaticResource Card}">
          <Grid>
            <StackPanel Margin="0,0,58,0">
              <TextBlock Text="按键声" Style="{StaticResource RowTitle}"/>
              <TextBlock Text="按下是轻点，松开是抬起，退格更低" Style="{StaticResource RowNote}"/>
            </StackPanel>
            <CheckBox x:Name="KeySoundBox" Style="{StaticResource ToggleSwitch}"
                      HorizontalAlignment="Right" Background="#7EE0C3" Click="KeySoundClick"/>
          </Grid>
        </Border>

        <TextBlock Text="按键颜色" Style="{StaticResource SectionLabel}" Margin="4,8,0,8"/>
        <UniformGrid Columns="3" Margin="0,0,0,14">
          <Border Margin="0,0,6,0" CornerRadius="12" Padding="12,10" Background="#221C12" BorderBrush="#6A5430" BorderThickness="1">
            <StackPanel>
              <Ellipse Width="10" Height="10" Fill="#F3C56A" HorizontalAlignment="Left"/>
              <TextBlock Text="左键" Foreground="#F3C56A" FontSize="13" Margin="0,8,0,0"/>
              <TextBlock Text="金色" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
          <Border Margin="3,0,3,0" CornerRadius="12" Padding="12,10" Background="#121A28" BorderBrush="#34527A" BorderThickness="1">
            <StackPanel>
              <Ellipse Width="10" Height="10" Fill="#7EB6FF" HorizontalAlignment="Left"/>
              <TextBlock Text="右键" Foreground="#8EBEFF" FontSize="13" Margin="0,8,0,0"/>
              <TextBlock Text="蓝色" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
          <Border Margin="6,0,0,0" CornerRadius="12" Padding="12,10" Background="#10211C" BorderBrush="#2C6A58" BorderThickness="1">
            <StackPanel>
              <Ellipse Width="10" Height="10" Fill="#7EE0C3" HorizontalAlignment="Left"/>
              <TextBlock Text="中键" Foreground="#7EE0C3" FontSize="13" Margin="0,8,0,0"/>
              <TextBlock Text="绿色" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
          <Grid>
            <StackPanel Margin="0,0,58,0">
              <TextBlock Text="开机自启动" Style="{StaticResource RowTitle}"/>
              <TextBlock Text="登录后以管理员身份留在托盘" Style="{StaticResource RowNote}"/>
            </StackPanel>
            <CheckBox x:Name="StartupBox" Style="{StaticResource ToggleSwitch}"
                      HorizontalAlignment="Right" Background="#F0C56A" Click="StartupClick"/>
          </Grid>
        </Border>

        <Button Content="退出" Style="{StaticResource QuietButton}" Click="ExitClick"/>
      </StackPanel>
    </DockPanel>
  </Border>
</Window>
